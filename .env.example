# Required for /api/chat (Gemini 2.5 Flash — free tier, ~1500 req/day)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required if the league has any locked/private seasons (e.g. the current
# year usually is). Grab from fantasy.espn.com after logging in:
# DevTools → Application → Cookies → fantasy.espn.com
# ESPN_SWID={ABCD-1234-...}
# ESPN_S2=long-random-string
ESPN_SWID=
ESPN_S2=
